{
  "private": "true",
  "description": "Starter template for Vue",
  "author": "Elone Hoo <hi@elonehoo.me>",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3333",
    "build": "vite build",
    "preview": "vite preview --port 8766",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp package.json --commit --push --tag"
  },
  "dependencies": {
    "@unocss/reset": "^0.65.4",
    "@vueuse/core": "^11.3.0",
    "unocss": "^0.65.4",
    "vite-inspector": "workspace:*",
    "vite-plugin-inspect": "^0.10.6",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@iconify-json/carbon": "^1.2.26",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/ui": "^2.1.9",
    "@vue/test-utils": "^2.5.0",
    "bumpp": "^9.11.1",
    "eslint": "^9.39.5",
    "happy-dom": "^15.7.4",
    "typescript": "^5.9.3",
    "unplugin-auto-import-api": "^0.0.2",
    "unplugin-vue-components": "^0.28.0",
    "unplugin-vue-prop": "^0.0.10",
    "unplugin-vue-sfc-name": "^0.0.9",
    "vite": "^5.4.8",
    "vite-plugin-pages": "^0.33.3",
    "vitest": "^2.1.2",
    "vue-tsc": "^2.2.12"
  }
}
